# Образец локальной конфигурации. Скопируйте в .env перед `docker compose up`:
#     cp .env.example .env
#
# Значения ниже совпадают с тем, что по умолчанию ожидает tests/conftest.py,
# поэтому integration-тесты идут против этого же контейнера без единого
# дополнительного экспорта:
#     docker compose up -d --wait db redis
#     poetry run pytest -m integration
#
# --wait обязателен: без него pytest стартует раньше, чем PostgreSQL примет
# соединения, и integration-тесты падают с ConnectionResetError.
#
# Для чего-либо, кроме локальной машины, SECRET_KEY обязан быть заменён.
POSTGRES_USER=rc_test
POSTGRES_PASSWORD=rc_test
POSTGRES_DB=rc_bench_test
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/15
SECRET_KEY=local-development-only-not-a-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
